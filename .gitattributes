# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit binary declarations
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Source and documentation
*.md text
*.json text
*.ts text
*.js text
*.astro text
